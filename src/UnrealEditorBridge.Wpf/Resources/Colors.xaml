<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 배경 -->
    <Color x:Key="PrimaryBackgroundColor">#1E1E1E</Color>
    <Color x:Key="SecondaryBackgroundColor">#252526</Color>
    <Color x:Key="TertiaryBackgroundColor">#2D2D30</Color>
    <Color x:Key="PanelBorderColor">#3F3F46</Color>

    <!-- 텍스트 -->
    <Color x:Key="PrimaryTextColor">#D4D4D4</Color>
    <Color x:Key="SecondaryTextColor">#969696</Color>
    <Color x:Key="AccentTextColor">#569CD6</Color>

    <!-- 연결 상태 -->
    <Color x:Key="ConnectedColor">#4CAF50</Color>
    <Color x:Key="DisconnectedColor">#888888</Color>
    <Color x:Key="ConnectingColor">#FFC107</Color>
    <Color x:Key="LostColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>

    <!-- 브러시 -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

</ResourceDictionary>
