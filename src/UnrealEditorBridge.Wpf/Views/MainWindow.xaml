<Window x:Class="UnrealEditorBridge.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UnrealEditorBridge.Wpf.Views"
        Title="UnrealEditorBridge"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource PrimaryBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- 연결 상태 패널 (상단) -->
        <views:ConnectionPanelView DockPanel.Dock="Top"
                                    DataContext="{Binding Connection}" />

        <!-- 상태 표시줄 (하단) -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource TertiaryBackgroundBrush}"
                Padding="8,4"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource DefaultTextStyle}" />
        </Border>

        <!-- 이벤트 로그 (하단) -->
        <views:EventLogView DockPanel.Dock="Bottom"
                            DataContext="{Binding EventLog}"
                            Height="200" />

        <!-- 에셋 영역 (중앙) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="350" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 에셋 목록 (좌) -->
            <views:AssetListView Grid.Column="0"
                                  DataContext="{Binding AssetList}" />

            <!-- 스플리터 -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource PanelBorderBrush}" />

            <!-- 에셋 상세 (우) -->
            <views:AssetDetailView Grid.Column="2"
                                    DataContext="{Binding AssetDetail}" />
        </Grid>
    </DockPanel>
</Window>
