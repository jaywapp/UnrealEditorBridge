<UserControl x:Class="UnrealEditorBridge.Wpf.Views.ConnectionPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UnrealEditorBridge.Wpf.Converters">

    <UserControl.Resources>
        <converters:ConnectionStateToColorConverter x:Key="StateToColor" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Margin="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 상태 표시 행 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                         Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                <TextBlock Text="{Binding StateText}" Style="{StaticResource DefaultTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 인스턴스 선택 행 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="인스턴스:" Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="250" Margin="0,0,6,0"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance}"
                          DisplayMemberPath="ProjectName" />
                <Button Content="새로고침" Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding RefreshInstancesCommand}" />
                <Button Content="연결" Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding ConnectCommand}" />
                <Button Content="연결 해제" Style="{StaticResource DefaultButtonStyle}"
                        Command="{Binding DisconnectCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
