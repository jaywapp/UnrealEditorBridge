<UserControl x:Class="UnrealEditorBridge.Wpf.Views.AssetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UnrealEditorBridge.Wpf.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Margin="4">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="에셋 상세" Style="{StaticResource HeaderTextStyle}" />

            <!-- 선택 없음 -->
            <TextBlock Text="에셋을 선택하면 상세 정보가 표시됩니다."
                       Style="{StaticResource LabelTextStyle}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <!-- 상세 정보 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,4,0,0">
                    <!-- 기본 정보 -->
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Asset Name" />
                    <TextBlock Style="{StaticResource DefaultTextStyle}" Text="{Binding AssetName}"
                               Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Class" />
                    <TextBlock Style="{StaticResource DefaultTextStyle}" Text="{Binding ClassName}"
                               Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Object Path" />
                    <TextBlock Style="{StaticResource DefaultTextStyle}" Text="{Binding ObjectPath}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Package Path" />
                    <TextBlock Style="{StaticResource DefaultTextStyle}" Text="{Binding PackagePath}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- 태그 -->
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Tags" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource LabelTextStyle}"
                                               Margin="0,0,6,0" MinWidth="100" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource DefaultTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 하드 의존성 -->
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Hard Dependencies" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding HardDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource DefaultTextStyle}"
                                           Margin="8,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 소프트 의존성 -->
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Soft Dependencies" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding SoftDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource DefaultTextStyle}"
                                           Margin="8,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
