<UserControl x:Class="UnrealEditorBridge.Wpf.Views.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UnrealEditorBridge.Wpf.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EventTypeToIconConverter x:Key="EventTypeToIcon" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Margin="4">
        <DockPanel>
            <!-- 헤더 + 버튼 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="이벤트 로그" Style="{StaticResource HeaderTextStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="생성" IsChecked="{Binding ShowCreated}"
                              Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0" />
                    <CheckBox Content="삭제" IsChecked="{Binding ShowDeleted}"
                              Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0" />
                    <CheckBox Content="변경" IsChecked="{Binding ShowRenamed}"
                              Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0" />
                    <CheckBox Content="저장" IsChecked="{Binding ShowSaved}"
                              Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0" />
                    <CheckBox Content="기타" IsChecked="{Binding ShowOther}"
                              Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0" />
                    <Button Content="지우기" Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- 오버플로 경고 -->
            <Border DockPanel.Dock="Top" Background="#44FF9800" Padding="8,4"
                    Visibility="{Binding HasOverflowWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="X" Padding="4,0"
                            Command="{Binding DismissOverflowWarningCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding OverflowMessage}" Style="{StaticResource DefaultTextStyle}"
                               Foreground="#FFFFCC00" />
                </DockPanel>
            </Border>

            <!-- 이벤트 목록 -->
            <ListView ItemsSource="{Binding Events}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      Background="Transparent"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="30"
                                        DisplayMemberBinding="{Binding EventType, Converter={StaticResource EventTypeToIcon}}" />
                        <GridViewColumn Header="시각" Width="80"
                                        DisplayMemberBinding="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                        <GridViewColumn Header="설명" Width="400"
                                        DisplayMemberBinding="{Binding Description}" />
                        <GridViewColumn Header="경로" Width="300"
                                        DisplayMemberBinding="{Binding ObjectPath}" />
                    </GridView>
                </ListView.View>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
