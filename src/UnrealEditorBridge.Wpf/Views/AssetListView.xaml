<UserControl x:Class="UnrealEditorBridge.Wpf.Views.AssetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource PanelStyle}" Margin="4">
        <DockPanel>
            <!-- 헤더 -->
            <TextBlock DockPanel.Dock="Top" Text="에셋 목록" Style="{StaticResource HeaderTextStyle}" />

            <!-- 필터 영역 -->
            <Grid DockPanel.Dock="Top" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="검색..." Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Width="150" Margin="0,0,4,0"
                          ItemsSource="{Binding AvailableClasses}"
                          SelectedItem="{Binding ClassFilter}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="초기화" Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding ClearFiltersCommand}" />
                    <Button Content="새로고침" Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- 카운트 표시 -->
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource LabelTextStyle}" Margin="0,4,0,0">
                <Run Text="총" /><Run Text=" " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text="개 / " />
                <Run Text="{Binding FilteredCount, Mode=OneWay}" /><Run Text="개 표시" />
            </TextBlock>

            <!-- 에셋 목록 -->
            <ListView ItemsSource="{Binding FilteredAssets}"
                      SelectedItem="{Binding SelectedAsset}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      Background="Transparent"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="이름" Width="200"
                                        DisplayMemberBinding="{Binding AssetName}" />
                        <GridViewColumn Header="클래스" Width="180"
                                        DisplayMemberBinding="{Binding ClassName}" />
                        <GridViewColumn Header="경로" Width="300"
                                        DisplayMemberBinding="{Binding ObjectPath}" />
                    </GridView>
                </ListView.View>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
